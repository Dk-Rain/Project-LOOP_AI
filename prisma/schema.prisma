generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ANALYST
  VIEWER
}

enum FeedbackStatus {
  NEW
  REVIEWED
  ACTIONED
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  feedbacks Feedback[]
  themes    Theme[]
  reports   Report[]
}

model User {
  id          String     @id @default(cuid())
  name        String
  email       String     @unique
  password    String
  role        Role       @default(VIEWER)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Feedback {
  id             String         @id @default(cuid())
  content        String
  channel        String         // "MANUAL", "CSV", "SIMULATED", "ZENDESK", "DISCORD", "INTERCOM"
  sentiment      String         // "Positive" | "Neutral" | "Negative"
  sentimentScore Float          // -1.0 to 1.0
  featureArea    String?
  status         FeedbackStatus @default(NEW)
  rationale      String?
  customerName   String?
  customerEmail  String?
  workspaceId    String
  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  themes         Theme[]        @relation("FeedbackThemes")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Theme {
  id          String     @id @default(cuid())
  name        String
  workspaceId String
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  feedbacks   Feedback[] @relation("FeedbackThemes")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([name, workspaceId])
}

model Report {
  id          String    @id @default(cuid())
  title       String
  periodStart DateTime
  periodEnd   DateTime
  content     String    // JSON AI report content
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
}
